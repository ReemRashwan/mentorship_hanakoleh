<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionXpathFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2_xpath.dtd">

<suppressions>
    <!-- Suppress MethodName check only for @Test methods containing an underscore -->
    <suppress-xpath checks="MethodName"
                    query="//METHOD_DEF[contains(./IDENT/@text, '_') and .//ANNOTATION/IDENT[@text='Test' or @text='ParameterizedTest']]"/>
</suppressions>